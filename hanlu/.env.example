# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=https://hanlu.app

# --- Analytics -------------------------------------------------------------
# Plausible (cookieless traffic + conversion goals). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Use the manual script so App Router navigations are tracked by our tracker.
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.manual.js

# PostHog (product analytics: funnels, retention). Only loaded after consent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Session recording (off by default; mention it in the privacy policy if you enable it)
NEXT_PUBLIC_POSTHOG_RECORDING=false

# --- Monetisation ----------------------------------------------------------
# Turn the paywall on (HSK 2+ lessons require Pro). Off = everything open (demo mode).
NEXT_PUBLIC_PAYWALL_ENABLED=false
# Stripe Payment Links (or any checkout URL)
NEXT_PUBLIC_CHECKOUT_MONTHLY=
NEXT_PUBLIC_CHECKOUT_YEARLY=
NEXT_PUBLIC_CHECKOUT_LIFETIME=

# --- Legal -----------------------------------------------------------------
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_CONTACT_EMAIL=
